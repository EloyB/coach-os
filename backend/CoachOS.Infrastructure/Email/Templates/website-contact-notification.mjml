<mjml>
  <mj-head>
    <mj-title>Nieuw contactbericht via coach-os.be</mj-title>
    <mj-preview>Nieuw contactbericht via het websiteformulier</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text color="#111827" font-size="15px" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#FAFAF8" width="600px">
    <mj-section background-color="#FFFFFF" padding="32px 40px">
      <mj-column>
        <mj-text font-size="22px" font-weight="700">Nieuw contactbericht</mj-text>
        <mj-text>
          <strong>Naam:</strong> {{name}}<br />
          <strong>E-mail:</strong> <a href="mailto:{{email}}" style="color:#2D5016">{{email}}</a><br />
          <strong>Organisatie:</strong> {{organization}}<br />
          <strong>Ontvangen:</strong> {{receivedAt}} (UTC)
        </mj-text>
        <mj-text><div style="white-space:pre-wrap">{{message}}</div></mj-text>
        <mj-text font-size="12px" color="#6b7280">Antwoord rechtstreeks aan de afzender. Het bericht wordt twaalf maanden na ontvangst automatisch verwijderd uit CoachOS.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
