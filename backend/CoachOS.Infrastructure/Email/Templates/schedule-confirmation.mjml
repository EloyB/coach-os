<mjml>
  <mj-head>
    <mj-title>Bevestig je lesmoment: {{seriesName}}</mj-title>
    <mj-preview>Bevestig je lesmoment voor {{seriesName}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text color="#6b7280" font-size="15px" line-height="1.6" />
      <mj-class name="heading" font-size="26px" font-weight="700" color="#111827" letter-spacing="-0.5px" line-height="1.2" />
      <mj-class name="fine" font-size="13px" color="#9ca3af" />
      <mj-class name="brand" color="#FFFFFF" font-size="22px" font-weight="700" letter-spacing="-0.5px" />
      <mj-class name="tagline" color="#D0FF14" font-size="11px" letter-spacing="2px" font-weight="600" text-transform="uppercase" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#FAFAF8" width="600px">
    <mj-section css-class="cos-header" background-color="#2D5016" padding="28px 40px" border-radius="12px 12px 0 0">
      <mj-column>
        <mj-text mj-class="brand"><img src="cid:coachos-logo" alt="" width="40" height="40" style="width:40px;height:40px;border-radius:9px;vertical-align:middle;margin-right:12px" />Coach<span style="color:#D0FF14">OS</span></mj-text>
      </mj-column>
    </mj-section>

    <mj-section css-class="cos-card" background-color="#FFFFFF" padding="40px">
      <mj-column>
        <mj-text mj-class="heading">Bevestig je lesmoment</mj-text>
        <mj-text padding-top="16px">
          Hoi {{studentName}}, we hebben een tijdslot voor je gereserveerd in
          <strong style="color:#111827">{{seriesName}}</strong>. Bevestig binnen 72 uur.
        </mj-text>

        <mj-section background-color="#FAFAF8" border-left="4px solid #D0FF14" border-radius="8px" padding="16px 20px">
          <mj-column>
            <mj-text font-size="14px" font-weight="600" color="#111827" padding="0">{{dayName}} {{startTime}} — {{endTime}}</mj-text>
            <mj-text font-size="13px" color="#6b7280" padding="4px 0 0">{{courtLine}}</mj-text>
            <mj-text font-size="13px" color="#6b7280" padding="4px 0 0">{{participantsLine}}</mj-text>
          </mj-column>
        </mj-section>

        <mj-button background-color="#2D5016" color="#FFFFFF" border-radius="8px" font-weight="600" font-size="15px" padding="32px 0" inner-padding="14px 28px" href="{{confirmationUrl}}">
          Bevestigen of wijzigen
        </mj-button>

        <mj-text mj-class="fine" padding-top="20px">
          Geen antwoord binnen 72 uur? Dan neemt je club contact op.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section css-class="cos-info" background-color="#FAFAF8" padding="24px 40px">
      <mj-column>
        <mj-text mj-class="fine" align="center">
          Verstuurd door CoachOS — vragen?
          <a href="mailto:info@coach-os.be" style="color:#2D5016;text-decoration:none;font-weight:600">info@coach-os.be</a>
        </mj-text>
        <mj-text font-size="11px" color="#d1d5db" align="center" padding-top="8px">
          © {{year}} CoachOS
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
