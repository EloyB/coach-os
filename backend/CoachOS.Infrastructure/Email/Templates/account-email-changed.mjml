<mjml>
  <mj-head>
    <mj-title>Je e-mailadres is gewijzigd — CoachOS</mj-title>
    <mj-preview>Het e-mailadres van je CoachOS-account is gewijzigd</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text color="#6b7280" font-size="15px" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#FAFAF8" width="600px">
    <mj-section background-color="#2D5016" padding="28px 40px">
      <mj-column><mj-text color="#FFFFFF" font-size="22px" font-weight="700">CoachOS</mj-text></mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="40px">
      <mj-column>
        <mj-text font-size="26px" font-weight="700" color="#111827">Je e-mailadres is gewijzigd</mj-text>
        <mj-text>Hoi {{firstName}},<br /><br />Het e-mailadres van je CoachOS-account is gewijzigd naar <strong>{{newEmail}}</strong>. Vanaf nu log je in met dat adres en komen alle e-mails daar terecht.</mj-text>
        <mj-text font-size="13px">Heb jij dit niet gedaan? Neem dan meteen contact op met je club of met CoachOS via info@coach-os.be.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section><mj-column><mj-text align="center" font-size="11px">© {{year}} CoachOS</mj-text></mj-column></mj-section>
  </mj-body>
</mjml>