# /etc/coachos-backup/offsite-backup.env — eigenaar root:coachos-backup, mode 0640.
# Nooit committen met echte waarden.

# ── restic-repository (Scaleway Object Storage, EU) ─────────────────────────
# Aparte bucket, versleuteld door restic (AES-256). Regio fr-par of nl-ams.
RESTIC_REPOSITORY=s3:https://s3.fr-par.scw.cloud/coachos-offsite-backup/restic
# Bestand met het repo-wachtwoord (0400, eigenaar coachos-backup). Bewaar een
# kopie in de kluis: zonder dit wachtwoord is de backup onbruikbaar.
RESTIC_PASSWORD_FILE=/etc/coachos-backup/restic-password
# Scaleway IAM API-key met alleen ObjectStorage-rechten op dit project/bucket.
AWS_ACCESS_KEY_ID=SCWXXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=00000000-0000-0000-0000-000000000000
AWS_DEFAULT_REGION=fr-par

# ── DataProtection-keyring ──────────────────────────────────────────────────
# Host-pad van het Docker-volume data_protection_keys. Controleer met:
#   docker volume inspect app_data_protection_keys --format '{{ .Mountpoint }}'
KEYRING_DIR=/var/lib/docker/volumes/app_data_protection_keys/_data

# ── Database (Scaleway managed PostgreSQL 17) ──────────────────────────────
# pg_dump moet versie 17 of hoger zijn (postgresql-client-17 via PGDG-apt).
PGHOST=xxx.rdb.fr-par.scw.cloud
PGPORT=5432
PGDATABASE=coachos
PGUSER=coachos
# Liever een PGPASSFILE (0400, eigenaar coachos-backup) dan PGPASSWORD hier.
PGPASSFILE=/etc/coachos-backup/pgpass
PGSSLMODE=require

# ── Optioneel ──────────────────────────────────────────────────────────────
# Healthcheck-URL (bv. healthchecks.io). Succes pingt de URL, falen <URL>/fail;
# geen ping binnen de verwachte periode = alarm.
#HEALTHCHECK_URL=https://hc-ping.com/<uuid>
#BACKUP_HOST=coachos-prod
#RETENTION_DAILY=14
#RETENTION_WEEKLY=8
#CHECK_WEEKDAY=7
#CHECK_READ_DATA_SUBSET=5%
#PG_DUMP_BIN=/usr/lib/postgresql/17/bin/pg_dump
