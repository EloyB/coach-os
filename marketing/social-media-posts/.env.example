# CoachOS Social Media — Configuration template
# Copy this file to .env and fill in your real values.
# .env is gitignored and will never be committed.

# ─────────────────────────────────────────────────────
# Make.com webhook
# ─────────────────────────────────────────────────────
# 1. In Make.com, create a new Scenario
# 2. Add module: Webhooks > Custom webhook
# 3. Click "Create a webhook" → name it, add an API key for auth
# 4. After saving, copy the URL from the webhook settings panel
# 5. Paste both values below (no quotes)
#
# The single URL handles both LinkedIn and Instagram —
# the scenario uses a Router that branches on the
# "platform" field in the JSON payload we send.
# The API key is sent in the x-make-apikey header.

MAKE_WEBHOOK_URL=
MAKE_API_KEY=
